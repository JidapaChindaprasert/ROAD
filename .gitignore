# Dependencies
node_modules/
road/node_modules/
/.pnp
.pnp.*

# Next.js build output
.next/
road/.next/
out/
road/out/
build/
road/build/

# Environment files - NEVER commit secrets
.env*
road/.env*
!.env.example
!road/.env.example

# Testing & Reports
coverage/
road/coverage/
test-results/
road/test-results/
playwright-report/
road/playwright-report/

# Logs & temp
*.log
road/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
road/next-env.d.ts
.vercel/
road/.vercel/

# AI Training, weights & datasets
runs/
weights/

# Ignore everything in road-ai except what is required for Render deployment
road-ai/*
!road-ai/main.py
!road-ai/requirements.txt
!road-ai/best_v3.pt
!road-ai/Dockerfile
!road-ai/.dockerignore
!road-ai/README.md

# Python caches and metadata
**/__pycache__/
*.py[cod]
*$py.class
*.Zone.Identifier
